{
  // General Settings
  "when_closing_with_no_tabs": "keep_window_open",
  "on_last_window_closed": "quit_app",
  "use_system_path_prompts": false,
  "use_system_prompts": false,
  "redact_private_values": false,
  "cli_default_open_behavior": "existing_window",

  // Security & Workspace Restoration
  "session": {
    "trust_all_worktrees": true,
    "restore_unsaved_buffers": true,
  },
  "restore_on_startup": "last_workspace",

  // Privacy
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Auto Update
  "auto_update": true,

  // Theme
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "One Dark",
  },
  "icon_theme": "Zed (Default)",

  // Buffer Font
  "buffer_font_family": "Josefka Fixed",
  "buffer_font_size": 13,
  "buffer_font_weight": 400.0,
  "buffer_line_height": "standard",

  // UI Font
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 15.0,
  "ui_font_weight": 400.0,

  // Agent Panel Font
  "agent_ui_font_size": 15.0,
  "agent_buffer_font_size": 13.0,

  // Cursor
  "multi_cursor_modifier": "alt",
  "cursor_blink": true,
  "cursor_shape": "bar",
  "hide_mouse": "on_typing_and_movement",

  // Highlighting & Guides
  "current_line_highlight": "gutter",
  "selection_highlight": true,
  "rounded_selection": true,
  "show_wrap_guides": true,

  // Base Keymap & Modal Editing
  // TODO

  // Auto Save
  "autosave": "off",

  // Which-key Menu
  // TODO

  // Multibuffer
  // TODO

  // Scrolling
  // TODO

  // Signature Help
  // TODO

  // Hover Popover
  // TODO

  // Drag And Drop Selection
  // TODO

  // Gutter
  "gutter": {
    "line_numbers": false,
    "runnables": true,
    "breakpoints": true,
    "bookmarks": true,
    "folds": false,
  },
  "relative_line_numbers": "disabled",
  "inline_code_actions": true,

  // Scrollbar
  "scrollbar": {
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
    "diagnostics": "all",
    "axes": {
      "horizontal": false,
      "vertical": true,
    },
  },

  // Minimap
  "minimap": {
    "show": "never"
  },

  // Toolbar
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },

  // Vim
  // TODO

  // Indentation
  "tab_size": 4,
  "hard_tabs": false,
  "auto_indent": "syntax_aware",
  "auto_indent_on_paste": true,

  // Wrapping
  "soft_wrap": "none",
  "preferred_line_length": 80,
  "allow_rewrap": "in_comments",

  // Indent Guides
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "fixed",
    "background_coloring": "disabled",
  },

  // Formatting
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "use_on_type_format": true,
  }
